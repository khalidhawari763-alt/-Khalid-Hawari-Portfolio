# Copy this file to `.env` and fill in the values before running.
# `pnpm install` will refuse to proceed with a real `.env` present in some setups,
# so keep secrets out of version control.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string (used by the API server + Drizzle).
# Example: postgres://user:password@localhost:5432/khalid_portfolio
DATABASE_URL=

# Port the API server listens on (required by artifacts/api-server/src/index.ts).
PORT=5000

# Base path the portfolio SPA is served from.
# "/" for a root-domain deploy; "/my-site" for a sub-path deploy.
BASE_PATH=/

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Node environment. "production" disables pino-pretty and enables JSON logging.
NODE_ENV=development

# Minimum pino log level (trace | debug | info | warn | error | fatal).
LOG_LEVEL=info

# Set by the Replit runtime. Only needed when running on Replit.
REPL_ID=

# ---------------------------------------------------------------------------
# Contact form email delivery
# ---------------------------------------------------------------------------
# The portfolio's Contact form POSTs to POST /api/contact-messages, which saves
# the message to the database and then emails it to khalidhawari763@gmail.com
# via Resend (see artifacts/api-server/src/lib/resend.ts).

# Currently the server uses Replit's built-in Resend connector, which works
# automatically on Replit. To send email outside Replit, set a real Resend API
# key here and switch the `from:` address in resend.ts to a verified domain.
RESEND_API_KEY=
